meta {
  name: Logout
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "sessionId": "{{sessionId}}"
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should return success true", function() {
    expect(res.body.success).to.equal(true);
  });
}
