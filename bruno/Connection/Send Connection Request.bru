meta {
  name: Send Connection Request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/connection/send-request
  body: json
  auth: none
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "url": "{{testProfileUrl}}",
    "message": "Hi Nicolas! I'd love to connect with you."
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should return success true", function() {
    expect(res.body.success).to.equal(true);
  });
}

docs {
  ⚠️ WARNING: This will actually send a connection request!
  Only run this test if you want to connect with the test profile.
}
