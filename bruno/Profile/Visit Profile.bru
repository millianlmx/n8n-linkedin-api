meta {
  name: Visit Profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/profile/visit
  body: json
  auth: none
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "url": "{{testProfileUrl}}"
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should return success true", function() {
    expect(res.body.success).to.equal(true);
  });
}
