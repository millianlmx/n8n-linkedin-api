meta {
  name: Scrape Profile
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/profile/scrape
  body: json
  auth: none
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "url": "{{testProfileUrl}}"
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should return success true", function() {
    expect(res.body.success).to.equal(true);
  });
  
  test("should return profile data", function() {
    expect(res.body.data).to.be.an('object');
  });
}
