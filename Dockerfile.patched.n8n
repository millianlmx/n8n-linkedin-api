FROM node:20-alpine AS builder

# Copy n8n custom nodes source
WORKDIR /tmp/n8n_custom_nodes
COPY n8n_custom_nodes/package*.json ./
COPY n8n_custom_nodes/tsconfig.json ./
COPY n8n_custom_nodes/nodes ./nodes/
COPY n8n_custom_nodes/credentials ./credentials/

# Install dependencies and build
RUN npm install && npm run build

# Final stage
FROM n8nio/n8n:next

USER root

# Copy the patch script into the container
COPY patch-loader.js /tmp/patch-loader.js

# Run the patch
RUN node /tmp/patch-loader.js

# Create custom nodes directory (outside of /home/node/.n8n to avoid volume override)
RUN mkdir -p /usr/local/lib/n8n-custom-nodes && \
    chown -R node:node /usr/local/lib/n8n-custom-nodes

# Copy built custom nodes from builder stage
COPY --from=builder --chown=node:node /tmp/n8n_custom_nodes/dist /usr/local/lib/n8n-custom-nodes/dist
COPY --from=builder --chown=node:node /tmp/n8n_custom_nodes/package.json /usr/local/lib/n8n-custom-nodes/

# Set environment variable for custom nodes location
ENV N8N_CUSTOM_EXTENSIONS=/usr/local/lib/n8n-custom-nodes

USER node

WORKDIR /home/node
