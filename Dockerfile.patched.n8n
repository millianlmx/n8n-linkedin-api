FROM node:20-alpine AS builder

# Copy n8n custom nodes source
WORKDIR /tmp/n8n_custom_nodes
COPY n8n_custom_nodes/package*.json ./
COPY n8n_custom_nodes/tsconfig.json ./
COPY n8n_custom_nodes/nodes ./nodes/
COPY n8n_custom_nodes/credentials ./credentials/

# Install dependencies and build
RUN npm install && npm run build

# Verify build output
RUN ls -la /tmp/n8n_custom_nodes/ && \
    ls -la /tmp/n8n_custom_nodes/dist/ && \
    ls -la /tmp/n8n_custom_nodes/dist/nodes/

# Final stage
FROM n8nio/n8n:next

USER root

# Copy the patch script into the container
COPY patch-loader.js /tmp/patch-loader.js

# Run the patch
RUN node /tmp/patch-loader.js

# Create custom nodes directory
RUN mkdir -p /home/node/.n8n/custom && \
    chown -R node:node /home/node/.n8n

# Copy built custom nodes from builder stage
COPY --from=builder --chown=node:node /tmp/n8n_custom_nodes/dist /home/node/.n8n/custom/dist
COPY --from=builder --chown=node:node /tmp/n8n_custom_nodes/package.json /home/node/.n8n/custom/

# Verify copy
RUN ls -la /home/node/.n8n/custom/ && \
    ls -la /home/node/.n8n/custom/dist/ || echo "dist folder missing"

USER node

WORKDIR /home/node
