{
  "name": "n8n-nodes-linkedin-api",
  "version": "1.0.0",
  "description": "n8n nodes for LinkedIn API integration",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run copy:icons",
    "copy:icons": "cp nodes/*.svg dist/nodes/ 2>/dev/null || mkdir -p dist/nodes && cp nodes/*.svg dist/nodes/",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lintfix": "eslint . --fix"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "linkedin",
    "automation"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LinkedInApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Login.node.js",
      "dist/nodes/Profile.node.js",
      "dist/nodes/Connection.node.js",
      "dist/nodes/Messaging.node.js",
      "dist/nodes/Search.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}